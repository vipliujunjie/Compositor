    "Drag a color in the picture. Nearby color families move together." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图像中拖动某种颜色。邻近的色系会一起移动。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动某个点。点按可添加一个点。双击某个点可将其删除。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动绘制矩形 · Shift 添加 · Option 减去 · 拖动中再按 Shift 变正方形 · 选区内拖动可移动 · ⌘ 拖动移动像素 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Drag a text box · Click text to edit · Drag box handles to resize · ⌘Return finish · Escape cancel" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动创建文本框 · 点按文字编辑 · 拖动控制柄调整大小 · ⌘Return 完成 · Escape 取消"
          }
        }
      }
    },
    "Drag an ellipse · Shift add · Option subtract · Shift again mid-drag circle · Drag inside to move · Delete clears · ⌘D deselect" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动绘制椭圆 · Shift 添加 · Option 减去 · 拖动中再按 Shift 变正圆 · 选区内拖动可移动 · Delete 清除 · ⌘D 取消选择"
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在色轮内拖动。角度决定色相，距离决定饱和度。"
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图层上拖动以放置参考线。至少绘制两条线。"
          }
        }
      }
    },
    "Drag on the picture to move the curve for the tone under the pointer." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在图片上拖动，移动指针所在色调的曲线。"
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动或滚动可移动视图；双击可在适合屏幕与 100% 之间切换。"
          }
        }
      }
    },
    "Drag over blemishes to heal · [ ] size · Shift-[ ] hardness · Escape cancel · Space to pan" : {
