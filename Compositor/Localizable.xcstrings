        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动模糊"
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向上或向下拖动可提高或降低这些色调。沿底部拖动分隔条可更改每个区域覆盖的色调。"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每个粗像素绘制为实心方块，或绘制成类似点阵屏幕的圆形点。"
          }
        }
