    },
    "“%@” is a folder, which has no pixels of its own. Paint on a layer inside it, or on the folder’s mask." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是图层组，本身没有像素。请在它内部的图层上绘制，或在图层组的蒙版上绘制。"
          }
        }
      }
    },
    "“%@” is an adjustment layer, with no pixels to paint. Paint on its mask instead." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”是调整图层，没有可绘制的像素。请改为在它的蒙版上绘制。"
          }
        }
      }
    },
    "“%@” is hidden, or inside a hidden folder. Show it to paint on it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”已隐藏，或位于隐藏的图层组中。请显示它后再在其上绘制。"
          }
        }
      }
    },
