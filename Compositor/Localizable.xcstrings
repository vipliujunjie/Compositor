          }
        }
      }
    },
    "How far the blur softens, in pixels" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模糊的柔化程度，以像素为单位"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个像素的误差向相邻像素扩散的程度。越少，区域越平滑"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用配置文件扭曲校正的程度。"
