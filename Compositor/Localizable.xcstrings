    "How much of the profile vignetting correction is applied." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用配置文件晕影校正的程度。"
          }
        }
      }
    },
    "How much the curve also changes color strength. Zero matches Photoshop; lower keeps it to brightness, higher adds more color." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
