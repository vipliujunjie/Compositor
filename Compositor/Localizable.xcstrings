          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锐化从每条边缘向外延伸的距离，以像素为单位。"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整在明亮度上的作用范围。"
          }
        }
      }
    },
