        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 Option 点按设置源 · 拖动仿制 · [ ] 大小 · Shift-[ ] 硬度 · 1–0 不透明度 · Space 平移"
